# Template de variáveis do AI Lead Manager (E6-01).
# Copie para .env.claude-code e preencha. NÃO comite o arquivo real.

# GitHub
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_REPO=adr-lead-manager

# Banco de dados (schema lead_manager, usuário não-superuser)
DATABASE_URL=postgres://lead_manager_user:SENHA@HOST:5432/adr_scheduler

# Redis
REDIS_URL=

# Integrações
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
N8N_URL=
N8N_API_KEY=

# App
NODE_ENV=production
PORT=3002
JWT_SECRET=
# Chave que cifra segredos DENTRO da aplicação (AES-256-GCM): token da Evolution e as
# credenciais por unidade (plataforma.credencial_unidade). NÃO trocar depois de usar —
# o que já foi cifrado fica ilegível. Gere com: openssl rand -base64 48
LM_ENCRYPTION_KEY=

# LGPD — segredo dedicado p/ assinar o token de opt-out do lead (item 2).
# DEVE ter o MESMO valor no Scheduler. Se vazio, cai para JWT_SECRET.
OPTOUT_SECRET=

# ── Núcleo de plataforma (migr. 172/173) ─────────────────────────────────────
# ESTAS SÃO CHAVES DE INFRA, NÃO CREDENCIAIS DE CLIENTE.
# Credencial de provedor (IA, Meta, Evolution) é POR UNIDADE e vive cifrada em
# plataforma.credencial_unidade — nunca aqui. A cifra usa LM_ENCRYPTION_KEY (acima),
# a mesma chave que já protege o token da Evolution. Ver src/plataforma/credenciais.js.
#
# Cache do resolvedor de credencial, em ms (padrão 60000).
PLATAFORMA_CREDENCIAL_TTL_MS=
# Raiz da mídia do motor de marketing. Cada unidade escreve só em <raiz>/<tenant_id>/.
# A MESMA raiz está no CHECK de marketing.arquivo (migr. 173): mudar aqui exige mudar lá,
# senão toda gravação de mídia passa a ser recusada pelo banco.
ADR_MEDIA_ROOT=/srv/adr-media
