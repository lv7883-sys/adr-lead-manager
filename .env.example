# Template de variáveis do AI Lead Manager (E6-01).
# Copie para .env.claude-code e preencha. NÃO comite o arquivo real.

# GitHub
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_REPO=adr-lead-manager

# Banco de dados (schema lead_manager, usuário não-superuser)
DATABASE_URL=postgres://lead_manager_user:SENHA@HOST:5432/adr_scheduler

# Redis
REDIS_URL=

# Integrações
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
N8N_URL=
N8N_API_KEY=

# App
NODE_ENV=production
PORT=3002
JWT_SECRET=
# Chave que cifra segredos DENTRO da aplicação (AES-256-GCM): token da Evolution e as
# credenciais por unidade (plataforma.credencial_unidade). NÃO trocar depois de usar —
# o que já foi cifrado fica ilegível. Gere com: openssl rand -base64 48
LM_ENCRYPTION_KEY=

# LGPD — segredo dedicado p/ assinar o token de opt-out do lead (item 2).
# DEVE ter o MESMO valor no Scheduler. Se vazio, cai para JWT_SECRET.
OPTOUT_SECRET=

# ── Núcleo de plataforma (migr. 172/173) ─────────────────────────────────────
# ESTAS SÃO CHAVES DE INFRA, NÃO CREDENCIAIS DE CLIENTE.
# Credencial de provedor (IA, Meta, Evolution) é POR UNIDADE e vive cifrada em
# plataforma.credencial_unidade — nunca aqui. A cifra usa LM_ENCRYPTION_KEY (acima),
# a mesma chave que já protege o token da Evolution. Ver src/plataforma/credenciais.js.
#
# Cache do resolvedor de credencial, em ms (padrão 60000).
PLATAFORMA_CREDENCIAL_TTL_MS=
# Raiz da mídia do motor de marketing. Cada unidade escreve só em <raiz>/<tenant_id>/.
# A MESMA raiz está no CHECK de marketing.arquivo (migr. 173): mudar aqui exige mudar lá,
# senão toda gravação de mídia passa a ser recusada pelo banco.
ADR_MEDIA_ROOT=/srv/adr-media

# ============================================================================
# INVENTÁRIO (17/10/2026) — as 10 chaves abaixo EXISTEM no processo em produção
# e não estavam documentadas aqui.
#
# ⚠ O Lead Manager NÃO usa .env na VPS: as variáveis vêm do
# docker-compose.lead-manager.yml. Então este arquivo é documentação e ponto de
# partida para um ambiente novo — editar aqui NÃO muda produção. A prova do que
# o processo recebeu é `docker exec adr-lead-manager printenv <CHAVE>`.
#
# Chave que ninguém sabe que existe é chave que ninguém sabe que precisa
# ROTACIONAR. Das 10 abaixo, TRÊS são credenciais (marcadas).
# ============================================================================

# --- Infraestrutura (CREDENCIAL) ---
# ⚠ CREDENCIAL DE INFRAESTRUTURA, a mais pesada do inventário: quem a tem não
# mexe num módulo, mexe no que roda tudo. Usada para ler/alterar recursos no
# Coolify. Rotacionar exige gerar nova no painel antes de invalidar a atual.
COOLIFY_API_KEY=
COOLIFY_URL=

# --- Meta / Instagram / Facebook ---
# ⚠ CREDENCIAL: segredo do app da Meta. Trocar derruba o login e a ingestão de
# comentários até o novo valor estar nos dois lados.
META_APP_SECRET=
META_APP_ID=
META_LOGIN_CONFIG_ID=
# ⚠ CREDENCIAL: token que a Meta devolve na verificação do webhook. Se mudar
# aqui sem mudar no painel da Meta, a verificação falha e paramos de receber.
META_WEBHOOK_VERIFY_TOKEN=

# --- Evolution e mídia ---
# URL interna da Evolution (envio e leitura de WhatsApp).
EVOLUTION_URL=
# Raiz onde a mídia das conversas é gravada, por tenant.
# ⚠ Hoje aponta para dentro de `uploads/`, onde também está uma cópia do arquivo
# de sessão da Extranet. NÃO está exposta (não há express.static e a rota de
# mídia exige tenant em formato UUID), mas `uploads` costuma ser servido
# publicamente POR DESENHO em muitos projetos — mover é prevenção.
MEDIA_ROOT=

# --- URLs públicas ---
# Base pública do Lead Manager e a usada no link de opt-out do lead.
PUBLIC_BASE_URL=
OPTOUT_BASE_URL=
