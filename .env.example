# Template de variáveis do AI Lead Manager (E6-01).
# Copie para .env.claude-code e preencha. NÃO comite o arquivo real.

# GitHub
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_REPO=adr-lead-manager

# Coolify
COOLIFY_URL=
COOLIFY_API_KEY=

# Banco de dados (schema lead_manager, usuário não-superuser)
DATABASE_URL=postgres://lead_manager_user:SENHA@HOST:5432/adr_scheduler

# Redis
REDIS_URL=

# Integrações
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
N8N_URL=
N8N_API_KEY=

# App
NODE_ENV=production
PORT=3002
JWT_SECRET=

# LGPD — segredo dedicado p/ assinar o token de opt-out do lead (item 2).
# DEVE ter o MESMO valor no Scheduler. Se vazio, cai para JWT_SECRET.
OPTOUT_SECRET=
